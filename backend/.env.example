# ── LiteLLM Model Configuration ──────────────────────────────────────────────
# Set MODEL to any LiteLLM-supported model string.
# Examples:
#   gpt-4o-mini                      (OpenAI)
#   azure/gpt-4o                     (Azure OpenAI)
#   anthropic/claude-3-haiku-20240307
#   gemini/gemini-1.5-flash
#   groq/llama3-8b-8192
#   watsonx/ibm/granite-13b-chat-v2
#   ollama/llama3

MODEL=gpt-4o-mini

# ── Provider API Keys (fill only the one you use) ─────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# IBM watsonx.ai
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
